# Global
APP_NAME=hire-me
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
RATE_LIMIT_REQUESTS_PER_MINUTE=120
CORS_ORIGINS=http://localhost:4200

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hire_me
POSTGRES_USER=hire_me
POSTGRES_PASSWORD=hire_me_password
DATABASE_URL=postgresql+asyncpg://hire_me:hire_me_password@postgres:5432/hire_me

# GitHub integration
GITHUB_USERNAME=your-github-handle
GITHUB_TOKEN=

# AI provider
AI_PROVIDER=gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_VERIFY_TLS=true
AI_SYSTEM_PROMPT=You are a helpful AI assistant for the Hire Me application.
RESUME_OWNER_TOKEN=replace-with-owner-token
RESUME_PROFILE_PATH=app/data/resume_profile.json
ANALYTICS_STATS_PATH=app/data/site_analytics.json

# Frontend
API_BASE_URL=http://localhost:8000
GRAPHQL_URL=http://localhost:8000/graphql
WS_URL=ws://localhost:8000/ws/visitors
APP_TITLE=Hire Me
