# Global
APP_NAME=hire-me
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
RATE_LIMIT_REQUESTS_PER_MINUTE=120
CORS_ORIGINS=http://localhost:4200

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hire_me
POSTGRES_USER=hire_me
POSTGRES_PASSWORD=hire_me_password
DATABASE_URL=postgresql+asyncpg://hire_me:hire_me_password@postgres:5432/hire_me

# GitHub integration
GITHUB_USERNAME=your-github-handle
GITHUB_TOKEN=

# AI provider
AI_PROVIDER=ollama
GROQ_BASE_URL=https://api.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
AI_REQUEST_TIMEOUT_SECONDS=30
AI_SYSTEM_PROMPT=You are a helpful AI assistant for the Hire Me application.

# Frontend
API_BASE_URL=http://localhost:8000
GRAPHQL_URL=http://localhost:8000/graphql
WS_URL=ws://localhost:8000/ws/visitors
APP_TITLE=Hire Me
