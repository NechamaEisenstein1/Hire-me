APP_NAME=Hire Me
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
